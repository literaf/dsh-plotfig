{
  "name": "dsh-seedream",
  "version": "0.1.0",
  "description": "Seedream 5.5 for DeepSeek Harness: image generation and editing tools with a per-conversation canvas workspace.",
  "type": "module",
  "license": "MIT",
  "author": "ai4scholar",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client-types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README_CN.md",
    "RELEASING.md"
  ],
  "sideEffects": false,
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "seedream",
    "volcengine",
    "image-generation",
    "canvas"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:client",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:client": "tsdown && tsc -p tsconfig.client-types.json",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test",
    "postpublish": "node scripts/sync-mirror.mjs",
    "sync-mirror": "node scripts/sync-mirror.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "konva": "10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "18.2.16",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "icon": "./assets/icon.svg",
  "homepage": "https://www.npmjs.com/package/dsh-seedream"
}
